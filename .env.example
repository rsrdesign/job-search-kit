# Optional. The kit works without any key (company and remote job boards).
# Add one or more to also search by city across the web.
# Copy this file to .env. .env is git-ignored.

# Google Jobs via SerpApi: https://serpapi.com (free: 100 searches/month)
SERPAPI_KEY=

# Adzuna: https://developer.adzuna.com (free tier)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=es

# Jooble: https://jooble.org/api/about (free key on request)
JOOBLE_KEY=
